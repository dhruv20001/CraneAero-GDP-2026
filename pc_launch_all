On the PC:
	
	One terminal the vicon:
		cd ros2_ws/
		source install/setup.bash
		ros2 launch vicon_bridge all_segments.launch.py
	
	other terminal
	check if topicfs are shared: 
		ros2 topic list
	
	other terminal launch the octomap :
		ros2 run octomap_server octomap_server_node --ros-args -r cloud_in:=/voxel_filtered -p frame_id:=camera_link -p resolution:=0.1 -p publish_frequency:=10.0
		
	other terminal vicon copy node/!!!!!!!!!!!!!!!!\ careful its default here adapt in function :
	ros2 run vicon_waypoint_bridge bridge_node --ros-args \
	  -p vicon_topic:=/vicon/drone/pose \
	  -p target_x:=1.0 \
	  -p target_y:=0.0 \
	  -p target_z:=1.0 \
	  -p target_yaw_deg:=0.0 \
	  -p arm_and_takeoff:=true \
	  -p takeoff_altitude:=1.0	
		
		
	If connection not working try:
	ros2 daemon stop
	ros2 daemon start
		
